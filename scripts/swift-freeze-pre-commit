#!/bin/sh
# threadbear-swift-freeze: git's pre-commit hook, which worktree-setup.sh
# copies into the shared .git/hooks, so it runs for the main checkout and
# every worktree. It runs that checkout's own scripts/swift-freeze.sh, or,
# in a worktree branched before there was one, the main checkout's, so an
# older thread's commits are checked too (Codex's review, 12 Nov).
top="$(git rev-parse --show-toplevel)" || exit 0
f="$top/scripts/swift-freeze.sh"
if [ ! -x "$f" ]; then
  common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || exit 0
  f="$(dirname "$common")/scripts/swift-freeze.sh"
fi
[ -x "$f" ] && exec "$f" --commit
exit 0
